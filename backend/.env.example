# ==========================================
# PostgreSQL Database Configuration
# ==========================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=travel_planner
DB_USER=your_postgres_user
DB_PASSWORD=your_postgres_password

# Optional: Full database connection string
# DATABASE_URL=postgresql://your_postgres_user:your_postgres_password@localhost:5432/travel_planner

# ==========================================
# CORS Configuration
# ==========================================
# Comma-separated list of allowed origins (e.g. for Vite frontend)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# ==========================================
# Gemini LLM Configuration
# ==========================================
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
GEMINI_MIN_INTERVAL=1.0
